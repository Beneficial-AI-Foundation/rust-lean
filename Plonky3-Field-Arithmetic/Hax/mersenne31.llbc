ract 1.\n        sub -= over as u32;\n        Self::new_reduced(sub & Self::ORDER_U32)\n    }","attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"inputs":[{"Deduplicated":11},{"Deduplicated":11}],"output":{"Deduplicated":11}},"src":{"TraitImpl":{"impl_ref":{"id":8,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":11},{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}},"item_name":"sub","reuses_default":true}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":3,"beg":{"line":142,"col":4},"end":{"line":151,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":3,"beg":{"line":142,"col":31},"end":{"line":142,"col":35}},"generated_from_span":null},"ty":{"Deduplicated":11}},{"index":1,"name":"self","span":{"data":{"file_id":3,"beg":{"line":142,"col":11},"end":{"line":142,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":11}},{"index":2,"name":"rhs","span":{"data":{"file_id":3,"beg":{"line":142,"col":17},"end":{"line":142,"col":20}},"generated_from_span":null},"ty":{"Deduplicated":11}},{"index":3,"name":"sub","span":{"data":{"file_id":3,"beg":{"line":144,"col":13},"end":{"line":144,"col":20}},"generated_from_span":null},"ty":{"Deduplicated":9}},{"index":4,"name":"over","span":{"data":{"file_id":3,"beg":{"line":144,"col":22},"end":{"line":144,"col":26}},"generated_from_span":null},"ty":{"Deduplicated":12}},{"index":5,"name":null,"span":{"data":{"file_id":3,"beg":{"line":144,"col":30},"end":{"line":144,"col":67}},"generated_from_span":null},"ty":{"HashConsedValue":[29,{"Adt":{"i